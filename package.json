{
  "name": "sahoda",
  "private": true,
  "version": "0.1.0-alpha.0",
  "description": "SAHODA LABS \u2014 AI Marketing OS (monorepo)",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test && vitest run",
    "test:e2e": "pnpm --filter @sahoda/web test:e2e",
    "test:smoke": "pnpm --filter @sahoda/web test:smoke",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:new": "supabase --workdir packages/db migration new",
    "db:push": "supabase --workdir packages/db db push",
    "db:link": "supabase --workdir packages/db link",
    "ops:seed": "node scripts/ops-seed.mjs",
    "ops:sync": "node scripts/ops-sync.mjs",
    "test:ops": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "prettier": "^3.9.5",
    "supabase": "^2.109.1",
    "turbo": "^2.10.5",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
