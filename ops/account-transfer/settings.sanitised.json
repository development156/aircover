{
  "permissions": {
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "skillOverrides": {
    "api-design": "off",
    "backend-patterns": "off",
    "continuous-learning-v2": "off",
    "database-migrations": "off",
    "deployment-patterns": "off",
    "docker-patterns": "off",
    "eval-harness": "off",
    "frontend-patterns": "off",
    "mcp-server-patterns": "off",
    "postgres-patterns": "off",
    "python-patterns": "off",
    "python-testing": "off",
    "security-review": "off",
    "verification-loop": "off"
  },
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "notify-send \"Claude Code\" \"Task completed or needs your input!\" --icon=utilities-terminal"
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "fresh"
  },
  "disableRemoteControl": false,
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true,
    "ralph-loop@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "agent-sdk-dev@claude-plugins-official": true,
    "remember@claude-plugins-official": true,
    "brightdata-plugin@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "vercel@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "supabase@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "plugin-dev@claude-plugins-official": true,
    "playground@claude-plugins-official": true,
    "chrome-devtools-mcp@claude-plugins-official": true,
    "resend@claude-plugins-official": true,
    "sentry@claude-plugins-official": true,
    "mattpocock-skills@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "planetscale": {
      "source": {
        "source": "github",
        "repo": "planetscale/claude-plugin"
      }
    },
    "divas-personal": {
      "source": {
        "source": "directory",
        "path": "/home/divas/claude-personal-marketplace"
      }
    }
  },
  "modelSettings": {
    "claude-opus-5": {
      "effortLevel": "low"
    }
  },
  "advisorModel": "opus",
  "askUserQuestionTimeout": "5m",
  "dialogExpiry": "5m",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "auto",
  "editorMode": "normal",
  "verbose": true,
  "preferredNotifChannel": "terminal_bell",
  "showTurnDuration": true,
  "remoteControlAtStartup": false,
  "crossSessionInbound": "accept",
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "useAutoModeDuringPlan": true
}