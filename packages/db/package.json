    "db:push": "supabase --workdir . db push"
  },
  "dependencies": {
    "@sahoda/shared": "workspace:*"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@supabase/supabase-js": "^2.110.7",
    "@types/pg": "^8.20.0",
    "dotenv": "^17.4.2",
    "pg": "^8.22.0"
  }
}
