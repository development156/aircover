{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/sweeps",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/metrics",
      "schedule": "20 1 * * *"
    },
    {
      "path": "/api/cron/loop",
      "schedule": "0 21 * * 0"
    }
  ]
}
